{
  "name": "visualnovel",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:fixture": "CONTENT_DIR=tests/fixtures/content npm run content && vite",
    "build": "npm run content && tsc --noEmit && vite build",
    "content": "tsx scripts/build-content.ts",
    "validate": "tsx scripts/validate-content.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "shots": "playwright test",
    "scenes": "node art/kit/build.mjs scenes",
    "map": "node art/kit/map.mjs",
    "map:poster": "node art/kit/map.mjs && node art/kit/map-poster.mjs"
  },
  "dependencies": {
    "@preact/signals": "^2.11.4",
    "preact": "^11.2.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.6.6",
    "fake-indexeddb": "^6.2.7",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
