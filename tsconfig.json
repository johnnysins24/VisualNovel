{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "noUncheckedIndexedAccess": true, "skipLibCheck": true,
    "jsx": "react-jsx", "jsxImportSource": "preact", "lib": ["ES2022","DOM"],
    "resolveJsonModule": true, "isolatedModules": true, "noEmit": true,
    "types": ["vite/client", "node"]
  },
  "include": ["src", "scripts", "tests", "e2e", "vite.config.ts"]
}
